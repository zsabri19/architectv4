    "deliveries": ["list", "create", "deliver", "retry", "cancel"]
  },
  "invariantTopics": ["payment and entitlement consistency", "entitlement revocation and expiry", "delivery retry and cancellation"],
  "requiredScenarioChecks": ["entitlement-invariants", "delivery-invariants"]
}
